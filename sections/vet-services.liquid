{{ 'vet-clinic.css' | asset_url | stylesheet_tag }}

<div class="vet-section vet-services color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="vet-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vet-section__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.seo_heading }} class="vet-section__title h2">{{ section.settings.heading }}</{{ section.settings.seo_heading }}>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="vet-section__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="vet-services__grid">
      {%- for block in section.blocks -%}
        <div class="vet-service" {{ block.shopify_attributes }} {% if settings.enable_animation %}data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 80 }}"{% endif %}>
          <span class="vet-service__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              {%- case block.settings.icon -%}
                {%- when 'stethoscope' -%}
                  <path d="M6 3v6a6 6 0 0 0 12 0V3"/><path d="M6 3H4M18 3h2"/><path d="M12 15v2a4 4 0 0 0 8 0v-1"/><circle cx="20" cy="14" r="2"/>
                {%- when 'vaccine' -%}
                  <path d="m18 2 4 4M17 7l-11 11-4 1 1-4L14 4z"/><path d="m9 11 4 4"/>
                {%- when 'scissors' -%}
                  <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M8.1 8.1 20 20"/>
                {%- when 'surgery' -%}
                  <path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/>
                {%- when 'lab' -%}
                  <path d="M9 2v7L4 19a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3L15 9V2"/><path d="M8 2h8M6.5 15h11"/>
                {%- when 'pharmacy' -%}
                  <rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/>
                {%- when 'heart' -%}
                  <path d="M20.8 5.6a5.5 5.5 0 0 0-7.8 0L12 6.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1 7.8 7.7 7.8-7.7 1-1a5.5 5.5 0 0 0 0-7.8Z"/>
                {%- when 'paw' -%}
                  <circle cx="8" cy="6" r="2"/><circle cx="16" cy="6" r="2"/><circle cx="5" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="M12 12c-2.5 0-4.5 2-4.5 4.5S9 22 12 22s4.5-3 4.5-5.5S14.5 12 12 12Z"/>
                {%- when 'ambulance' -%}
                  <path d="M3 17V7a1 1 0 0 1 1-1h10v11"/><path d="M14 9h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/><path d="M8 10h3M9.5 8.5v3"/>
                {%- else -%}
                  <circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>
              {%- endcase -%}
            </svg>
          </span>

          {%- if block.settings.title != blank -%}
            <h3 class="vet-service__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="vet-service__text rte">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.price != blank -%}
            <div class="vet-service__price">
              {%- if block.settings.price_label != blank -%}
                <span>{{ block.settings.price_label }}</span>
              {%- endif -%}
              {{ block.settings.price }}
            </div>
          {%- endif -%}

          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <div class="vet-service__link">
              <a href="{{ block.settings.link }}" class="button button--secondary">
                <span class="btn-txt">{{ block.settings.link_label }}</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Servicios clínicos",
  "tag": "section",
  "class": "vet-services-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Nuestros servicios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que tu mascota necesita" },
    {
      "type": "select",
      "id": "seo_heading",
      "label": "Etiqueta del título (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "<p>37 años cuidando a las mascotas de Reñaca con equipo propio y atención cercana.</p>"
    },
    { "type": "header", "content": "Diseño" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "primary", "label": "Principal" },
        { "value": "secondary", "label": "Secundario" },
        { "value": "tertiary", "label": "Terciario" },
        { "value": "quaternary", "label": "Cuaternario" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servicio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "stethoscope", "label": "Estetoscopio" },
            { "value": "vaccine", "label": "Vacuna" },
            { "value": "scissors", "label": "Peluquería" },
            { "value": "surgery", "label": "Cirugía" },
            { "value": "lab", "label": "Laboratorio" },
            { "value": "pharmacy", "label": "Farmacia" },
            { "value": "heart", "label": "Corazón" },
            { "value": "paw", "label": "Huella" },
            { "value": "ambulance", "label": "Urgencias" }
          ],
          "default": "stethoscope"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Consulta general" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descripción",
          "default": "<p>Evaluación completa de tu mascota con diagnóstico y plan de tratamiento.</p>"
        },
        { "type": "text", "id": "price_label", "label": "Etiqueta del precio", "default": "Desde" },
        { "type": "text", "id": "price", "label": "Precio", "default": "$25.000" },
        { "type": "text", "id": "link_label", "label": "Texto del botón", "default": "Reservar hora" },
        { "type": "url", "id": "link", "label": "Enlace del botón" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Servicios clínicos",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "stethoscope",
            "title": "Consulta general",
            "text": "<p>Evaluación completa de tu mascota con diagnóstico y plan de tratamiento.</p>",
            "price": "$25.000"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "vaccine",
            "title": "Vacunación",
            "text": "<p>Plan de vacunas al día para cachorros, gatitos y adultos.</p>",
            "price": "$18.000"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "scissors",
            "title": "Peluquería",
            "text": "<p>Baño sanitario, corte y estética con amor y paciencia.</p>",
            "price": "$20.000"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "surgery",
            "title": "Cirugías",
            "text": "<p>Pabellón equipado y monitoreo permanente durante todo el procedimiento.</p>",
            "price": "$80.000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
