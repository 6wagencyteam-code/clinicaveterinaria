{{ 'vet-clinic.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign today = 'now' | date: '%Y-%m-%d'
-%}

<div class="vet-section vet-booking color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="vet-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vet-section__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.seo_heading }} class="vet-section__title h2">{{ section.settings.heading }}</{{ section.settings.seo_heading }}>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="vet-section__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="vet-booking__inner">
      <div class="vet-form">
        {%- form 'contact', id: 'VetBookingForm', class: 'vet-form__grid' -%}

          {%- if form.posted_successfully? -%}
            <p class="vet-form__status vet-form__status--success" tabindex="-1" autofocus>
              {{ section.settings.success_message }}
            </p>
          {%- elsif form.errors -%}
            <p class="vet-form__status vet-form__status--error" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- comment -%} Identifica el correo como una reserva de hora {%- endcomment -%}
          <input type="hidden" name="contact[Tipo de solicitud]" value="Reserva de hora">

          <div class="vet-field vet-field--full">
            <label for="VetBooking-service">{{ section.settings.label_service }}</label>
            <select id="VetBooking-service" name="contact[Servicio]" required>
              <option value="">{{ section.settings.placeholder_select }}</option>
              {%- for block in section.blocks -%}
                {%- if block.type == 'service' and block.settings.name != blank -%}
                  <option value="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
                    {{- block.settings.name -}}
                    {%- if block.settings.duration != blank %} — {{ block.settings.duration }}{% endif -%}
                  </option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>

          <div class="vet-field">
            <label for="VetBooking-name">{{ section.settings.label_name }}</label>
            <input
              type="text"
              id="VetBooking-name"
              name="contact[Nombre del tutor]"
              autocomplete="name"
              value="{% if customer %}{{ customer.name }}{% endif %}"
              required
            >
          </div>

          <div class="vet-field">
            <label for="VetBooking-phone">{{ section.settings.label_phone }}</label>
            <input
              type="tel"
              id="VetBooking-phone"
              name="contact[Teléfono]"
              autocomplete="tel"
              inputmode="tel"
              placeholder="+56 9 1234 5678"
              value="{% if customer %}{{ customer.phone }}{% endif %}"
              required
            >
          </div>

          <div class="vet-field vet-field--full">
            <label for="VetBooking-email">{{ section.settings.label_email }}</label>
            <input
              type="email"
              id="VetBooking-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>

          <div class="vet-field">
            <label for="VetBooking-pet">{{ section.settings.label_pet }}</label>
            <input type="text" id="VetBooking-pet" name="contact[Nombre de la mascota]" required>
          </div>

          <div class="vet-field">
            <label for="VetBooking-species">{{ section.settings.label_species }}</label>
            <select id="VetBooking-species" name="contact[Especie]" required>
              <option value="">{{ section.settings.placeholder_select }}</option>
              <option value="Perro">{{ section.settings.species_dog }}</option>
              <option value="Gato">{{ section.settings.species_cat }}</option>
              <option value="Otro">{{ section.settings.species_other }}</option>
            </select>
          </div>

          <div class="vet-field">
            <label for="VetBooking-date">{{ section.settings.label_date }}</label>
            <input type="date" id="VetBooking-date" name="contact[Fecha preferida]" min="{{ today }}" required>
          </div>

          <div class="vet-field">
            <label for="VetBooking-time">{{ section.settings.label_time }}</label>
            <select id="VetBooking-time" name="contact[Horario preferido]" required>
              <option value="">{{ section.settings.placeholder_select }}</option>
              {%- assign slots = section.settings.time_slots | split: ',' -%}
              {%- for slot in slots -%}
                {%- assign slot_clean = slot | strip -%}
                {%- if slot_clean != blank -%}
                  <option value="{{ slot_clean | escape }}">{{ slot_clean }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>

          <div class="vet-field vet-field--full">
            <label for="VetBooking-body">{{ section.settings.label_message }}</label>
            <textarea id="VetBooking-body" name="contact[Motivo de la consulta]" rows="4">{{ form.body }}</textarea>
          </div>

          {%- if section.settings.note != blank -%}
            <p class="vet-form__note">{{ section.settings.note }}</p>
          {%- endif -%}

          <div class="vet-form__submit">
            <button type="submit" class="button btn-block">
              <span class="btn-txt">{{ section.settings.button_label }}</span>
            </button>
          </div>
        {%- endform -%}
      </div>

      <aside class="vet-aside">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'contact_item' -%}
              {%- if block.settings.value != blank -%}
                <div class="vet-aside__item" {{ block.shopify_attributes }}>
                  <span class="vet-aside__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      {%- case block.settings.icon -%}
                        {%- when 'phone' -%}
                          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8 10a16 16 0 0 0 6 6l1.4-1.4a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>
                        {%- when 'location' -%}
                          <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>
                        {%- when 'clock' -%}
                          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                        {%- when 'mail' -%}
                          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>
                        {%- else -%}
                          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
                      {%- endcase -%}
                    </svg>
                  </span>
                  <div>
                    {%- if block.settings.label != blank -%}
                      <span class="vet-aside__label">{{ block.settings.label }}</span>
                    {%- endif -%}
                    <div class="vet-aside__value">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}">{{ block.settings.value }}</a>
                      {%- else -%}
                        {{ block.settings.value }}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}

            {%- when 'hours' -%}
              <div class="vet-aside__item" {{ block.shopify_attributes }}>
                <span class="vet-aside__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                  </svg>
                </span>
                <div style="flex:1">
                  {%- if block.settings.label != blank -%}
                    <span class="vet-aside__label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  <ul class="vet-hours">
                    {%- assign rows = block.settings.hours | newline_to_br | split: '<br />' -%}
                    {%- for row in rows -%}
                      {%- assign row_clean = row | strip_newlines | strip -%}
                      {%- if row_clean != blank -%}
                        {%- assign parts = row_clean | split: '|' -%}
                        <li>
                          <span>{{ parts[0] | strip }}</span>
                          {%- if parts.size > 1 -%}<span>{{ parts[1] | strip }}</span>{%- endif -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reserva de hora",
  "tag": "section",
  "class": "vet-booking-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño superior",
      "default": "Agenda online"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Reserva la hora de tu mascota"
    },
    {
      "type": "select",
      "id": "seo_heading",
      "label": "Etiqueta del título (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "<p>Completa el formulario y te confirmamos la hora por WhatsApp o correo dentro del horario de atención.</p>"
    },
    {
      "type": "header",
      "content": "Textos del formulario"
    },
    { "type": "text", "id": "label_service", "label": "Etiqueta: servicio", "default": "¿Qué servicio necesitas?" },
    { "type": "text", "id": "label_name", "label": "Etiqueta: nombre del tutor", "default": "Tu nombre" },
    { "type": "text", "id": "label_phone", "label": "Etiqueta: teléfono", "default": "Teléfono" },
    { "type": "text", "id": "label_email", "label": "Etiqueta: correo", "default": "Correo electrónico" },
    { "type": "text", "id": "label_pet", "label": "Etiqueta: nombre de la mascota", "default": "Nombre de tu mascota" },
    { "type": "text", "id": "label_species", "label": "Etiqueta: especie", "default": "Especie" },
    { "type": "text", "id": "species_dog", "label": "Opción: perro", "default": "Perro" },
    { "type": "text", "id": "species_cat", "label": "Opción: gato", "default": "Gato" },
    { "type": "text", "id": "species_other", "label": "Opción: otra especie", "default": "Otra" },
    { "type": "text", "id": "label_date", "label": "Etiqueta: fecha preferida", "default": "Fecha preferida" },
    { "type": "text", "id": "label_time", "label": "Etiqueta: horario preferido", "default": "Horario preferido" },
    {
      "type": "text",
      "id": "time_slots",
      "label": "Horarios disponibles",
      "info": "Sepáralos con comas.",
      "default": "Mañana (09:00 - 13:00), Tarde (15:00 - 19:00), Me acomoda cualquiera"
    },
    { "type": "text", "id": "label_message", "label": "Etiqueta: motivo", "default": "Cuéntanos brevemente el motivo" },
    { "type": "text", "id": "placeholder_select", "label": "Texto de selección vacía", "default": "Selecciona una opción" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Solicitar hora" },
    {
      "type": "text",
      "id": "note",
      "label": "Nota bajo el formulario",
      "default": "Esta es una solicitud de hora. Te confirmamos la disponibilidad antes de agendar."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensaje de éxito",
      "default": "¡Gracias! Recibimos tu solicitud y te contactaremos a la brevedad para confirmar la hora."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "primary", "label": "Principal" },
        { "value": "secondary", "label": "Secundario" },
        { "value": "tertiary", "label": "Terciario" },
        { "value": "quaternary", "label": "Cuaternario" }
      ],
      "default": "secondary"
    },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servicio agendable",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre del servicio", "default": "Consulta general" },
        { "type": "text", "id": "duration", "label": "Duración (opcional)", "default": "30 min" }
      ]
    },
    {
      "type": "contact_item",
      "name": "Dato de contacto",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "phone", "label": "Teléfono" },
            { "value": "mail", "label": "Correo" },
            { "value": "location", "label": "Dirección" },
            { "value": "clock", "label": "Reloj" }
          ],
          "default": "phone"
        },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Teléfono" },
        { "type": "text", "id": "value", "label": "Valor", "default": "+56 9 0000 0000" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    },
    {
      "type": "hours",
      "name": "Horario de atención",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Horario de atención" },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Horarios",
          "info": "Una línea por día. Separa el día y la hora con el símbolo |",
          "default": "Lunes a viernes | 09:00 - 19:00\nSábado | 10:00 - 14:00\nDomingo | Cerrado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reserva de hora",
      "blocks": [
        { "type": "service", "settings": { "name": "Consulta general", "duration": "30 min" } },
        { "type": "service", "settings": { "name": "Vacunación", "duration": "20 min" } },
        { "type": "service", "settings": { "name": "Peluquería y baño", "duration": "90 min" } },
        { "type": "service", "settings": { "name": "Control post-operatorio", "duration": "30 min" } },
        { "type": "contact_item", "settings": { "icon": "phone", "label": "Teléfono", "value": "+56 9 0000 0000" } },
        { "type": "contact_item", "settings": { "icon": "location", "label": "Dirección", "value": "Reñaca, Viña del Mar" } },
        { "type": "hours" }
      ]
    }
  ]
}
{% endschema %}
