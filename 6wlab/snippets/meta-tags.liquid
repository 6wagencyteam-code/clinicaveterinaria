{%- comment -%}Etiquetas para compartir en redes sociales y buscadores{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">

{%- if request.page_type == 'product' and product.featured_media -%}
  <meta property="og:image" content="http:{{ product.featured_media | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="http:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}Datos estructurados: ayuda a que Google entienda que es una clínica{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VeterinaryCare",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {% if settings.share_image %}"image": {{ settings.share_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      {% if settings.contact_phone != blank %}"telephone": {{ settings.contact_phone | json }},{% endif %}
      {% if settings.contact_address != blank %}"address": {{ settings.contact_address | json }},{% endif %}
      "description": {{ shop.description | default: shop.name | json }}
    }
  </script>
{%- endif -%}
