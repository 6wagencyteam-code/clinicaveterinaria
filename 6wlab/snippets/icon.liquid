{%- comment -%}
  Íconos en línea. Uso: {% render 'icon', name: 'cart' %}
  Van en el HTML para no pedir archivos extra al servidor.
{%- endcomment -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2.5l2.2 12.2a1.6 1.6 0 0 0 1.6 1.3h8.9a1.6 1.6 0 0 0 1.6-1.3L21 7H5.2"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'phone' -%}
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8 10a16 16 0 0 0 6 6l1.4-1.4a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>
    {%- when 'mail' -%}
      <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>
    {%- when 'pin' -%}
      <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    {%- when 'stethoscope' -%}
      <path d="M6 3v6a6 6 0 0 0 12 0V3"/><path d="M6 3H4M18 3h2"/><path d="M12 15v2a4 4 0 0 0 8 0v-1"/><circle cx="20" cy="14" r="2"/>
    {%- when 'vaccine' -%}
      <path d="m18 2 4 4M17 7 6 18l-4 1 1-4L14 4z"/><path d="m9 11 4 4"/>
    {%- when 'scissors' -%}
      <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M8.1 8.1 20 20"/>
    {%- when 'surgery' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/>
    {%- when 'lab' -%}
      <path d="M9 2v7L4 19a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3L15 9V2"/><path d="M8 2h8M6.5 15h11"/>
    {%- when 'pharmacy' -%}
      <rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/>
    {%- when 'paw' -%}
      <circle cx="8" cy="6" r="2"/><circle cx="16" cy="6" r="2"/><circle cx="5" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="M12 12c-2.5 0-4.5 2-4.5 4.5S9 22 12 22s4.5-3 4.5-5.5S14.5 12 12 12Z"/>
    {%- when 'heart' -%}
      <path d="M20.8 5.6a5.5 5.5 0 0 0-7.8 0L12 6.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.7 8.8-8.7a5.5 5.5 0 0 0 0-7.8Z"/>
    {%- when 'ambulance' -%}
      <path d="M3 17V7a1 1 0 0 1 1-1h10v11"/><path d="M14 9h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/><path d="M8 10h3M9.5 8.5v3"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M14 9V7a2 2 0 0 1 2-2h2V2h-3a5 5 0 0 0-5 5v2H7v3h3v10h4V12h3l1-3h-4Z"/>
    {%- when 'tiktok' -%}
      <path d="M15 3a5 5 0 0 0 5 5v3a8 8 0 0 1-5-1.8V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1V12a3 3 0 1 0 2 2.8V3h3Z"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
