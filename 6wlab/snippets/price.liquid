{%- comment -%}Precio con oferta. Uso: {% render 'price', product: product %}{%- endcomment -%}
{%- liquid
  assign target = product | default: variant
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
  else
    assign price = target.price
    assign compare = target.compare_at_price
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price {% if on_sale %}price--on-sale{% endif %}">
  {%- if product.price_varies and variant == null -%}
    <span>{{ 'products.from' | t }} {{ product.price_min | money }}</span>
  {%- elsif on_sale -%}
    <ins>{{ price | money }}</ins>
    <del><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ compare | money }}</del>
  {%- else -%}
    <span>{{ price | money }}</span>
  {%- endif -%}
</div>
