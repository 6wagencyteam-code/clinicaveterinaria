<script src="{{ 'vaccines.js' | asset_url }}" defer></script>
{%- assign today = 'now' | date: '%Y-%m-%d' -%}

<section class="section section--{{ section.settings.bg }}{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lede rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div data-vaccines>
      <script type="application/json" data-vaccines-data>
        {
          "locale": {{ request.locale.iso_code | json }},
          "vaccines": [
            {%- for block in section.blocks -%}
              {
                "name": {{ block.settings.name | json }},
                "species": {{ block.settings.species | json }},
                "weeks": {{ block.settings.weeks | json }},
                "recurrence": {{ block.settings.recurrence | json }},
                "note": {{ block.settings.note | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "states": {
            "done": {{ 'vaccines.state_done' | t | json }},
            "due": {{ 'vaccines.state_due' | t | json }},
            "soon": {{ 'vaccines.state_soon' | t | json }},
            "future": {{ 'vaccines.state_future' | t | json }}
          },
          "texts": {
            "defaultName": {{ 'vaccines.default_name' | t | json }},
            "ageIs": {{ 'vaccines.age_is' | t | json }},
            "oneDue": {{ 'vaccines.one_due' | t | json }},
            "manyDue": {{ 'vaccines.many_due' | t | json }},
            "noneDue": {{ 'vaccines.none_due' | t | json }},
            "booster": {{ 'vaccines.booster' | t | json }},
            "futureError": {{ 'vaccines.future_error' | t | json }},
            "unborn": {{ 'vaccines.unborn' | t | json }},
            "newborn": {{ 'vaccines.newborn' | t | json }},
            "weeks": {{ 'vaccines.weeks' | t | json }},
            "month": {{ 'vaccines.month' | t | json }},
            "months": {{ 'vaccines.months' | t | json }},
            "year": {{ 'vaccines.year' | t | json }},
            "years": {{ 'vaccines.years' | t | json }}
          }
        }
      </script>

      <form class="vx-form">
        <div class="field">
          <label for="vx-name-{{ section.id }}">{{ 'vaccines.pet_name' | t }}</label>
          <input id="vx-name-{{ section.id }}" type="text" data-pet-name autocomplete="off">
        </div>
        <div class="field">
          <label for="vx-species-{{ section.id }}">{{ 'vaccines.species' | t }}</label>
          <select id="vx-species-{{ section.id }}" data-pet-species required>
            <option value="dog">{{ 'booking.dog' | t }}</option>
            <option value="cat">{{ 'booking.cat' | t }}</option>
          </select>
        </div>
        <div class="field">
          <label for="vx-birth-{{ section.id }}">{{ 'vaccines.birth' | t }}</label>
          <input id="vx-birth-{{ section.id }}" type="date" data-pet-birth max="{{ today }}" required>
        </div>
        <div class="field vx-form__submit">
          <button class="btn btn--full" type="submit">{{ 'vaccines.submit' | t }}</button>
        </div>
      </form>

      <div class="vx-results" data-results hidden>
        <p class="vx-summary" data-summary></p>
        <ul class="vx-list" data-list></ul>

        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <p class="text-center" style="margin-top:2rem">
            <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
          </p>
        {%- endif -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="field-hint text-center" style="margin-top:1.5rem;max-width:60ch;margin-inline:auto">
            {{ section.settings.disclaimer }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .vx-form {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    max-width: 820px;
    margin: 0 auto calc(var(--gap) * 2);
    padding: calc(var(--gap) * 1.2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .vx-form .field { margin-bottom: 0; }
  .vx-form__submit { display: flex; align-items: flex-end; }
  .vx-results { max-width: 880px; margin-inline: auto; }
  .vx-results[hidden] { display: none; }
  .vx-summary {
    margin-bottom: 1.5rem; padding: 1.1rem 1.3rem;
    border-radius: var(--radius); background: var(--brand-soft); font-size: var(--step-1);
  }
  .vx-list { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .vx {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--line); border-left-width: 4px; border-radius: var(--radius);
  }
  .vx__dot { width: .7rem; height: .7rem; border-radius: 50%; background: currentColor; }
  .vx__name { margin: 0 0 .15rem; font-weight: 600; color: var(--ink); }
  .vx__meta { margin: 0; font-size: var(--step--1); color: var(--ink-muted); }
  .vx__state { font-size: var(--step--1); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .vx--done { border-left-color: var(--ok); color: var(--ok); }
  .vx--due { border-left-color: var(--alert); color: var(--alert); background: var(--alert-soft); }
  .vx--soon { border-left-color: var(--warn); color: var(--warn); }
  .vx--future { border-left-color: var(--line); color: var(--ink-muted); }
  @media (max-width: 620px) {
    .vx { grid-template-columns: auto 1fr; }
    .vx__state { grid-column: 2; }
  }

  /* Sobre fondo azul */
  .section--brand .vx-summary { background: rgba(255, 255, 255, 0.16); }
  .section--brand .vx {
    background: rgba(255, 255, 255, 0.96);
    border-color: transparent;
  }
  .section--brand .vx__name { color: var(--ink); }
  .section--brand .vx__meta { color: var(--ink-muted); }
  .section--brand .vx-results .btn { --btn-bg: #fff; --btn-ink: var(--brand); --btn-line: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "Calendario de vacunas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Herramienta gratuita" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Tu mascota tiene sus vacunas al día?" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Ingresa la fecha de nacimiento y te mostramos qué vacunas le corresponden y cuándo.</p>" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Reservar hora para vacunar" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" },
    { "type": "text", "id": "disclaimer", "label": "Aviso", "default": "Este calendario es referencial. El plan definitivo lo determina el médico veterinario." },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "brand",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    },
    { "type": "checkbox", "id": "tight", "label": "Menos espacio arriba y abajo", "default": true }
  ],
  "blocks": [
    {
      "type": "vaccine",
      "name": "Vacuna",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Vacuna múltiple" },
        {
          "type": "select", "id": "species", "label": "Aplica a", "default": "dog",
          "options": [
            { "value": "dog", "label": "Perros" },
            { "value": "cat", "label": "Gatos" },
            { "value": "both", "label": "Ambos" }
          ]
        },
        { "type": "number", "id": "weeks", "label": "Edad en semanas", "info": "Semanas de vida de la primera dosis.", "default": 8 },
        {
          "type": "select", "id": "recurrence", "label": "Repetición", "default": "once",
          "options": [
            { "value": "once", "label": "Una sola vez" },
            { "value": "annual", "label": "Cada año" },
            { "value": "quarterly", "label": "Cada 3 meses" }
          ]
        },
        { "type": "text", "id": "note", "label": "Nota (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Calendario de vacunas",
      "blocks": [
        { "type": "vaccine", "settings": { "name": "Primera múltiple (parvovirus y moquillo)", "species": "dog", "weeks": 6, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Segunda múltiple", "species": "dog", "weeks": 9, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Tercera múltiple", "species": "dog", "weeks": 12, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Refuerzo anual múltiple", "species": "dog", "weeks": 64, "recurrence": "annual" } },
        { "type": "vaccine", "settings": { "name": "Primera triple felina", "species": "cat", "weeks": 8, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Segunda triple felina", "species": "cat", "weeks": 12, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Leucemia felina", "species": "cat", "weeks": 16, "recurrence": "once" } },
        { "type": "vaccine", "settings": { "name": "Refuerzo anual triple felina", "species": "cat", "weeks": 64, "recurrence": "annual" } },
        { "type": "vaccine", "settings": { "name": "Antirrábica", "species": "both", "weeks": 16, "recurrence": "annual" } },
        { "type": "vaccine", "settings": { "name": "Desparasitación interna", "species": "both", "weeks": 4, "recurrence": "quarterly" } }
      ]
    }
  ]
}
{% endschema %}
