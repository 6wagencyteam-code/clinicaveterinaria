<section class="section section--{{ section.settings.bg }}{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap">
    <div class="rail-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rail-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte muted" style="margin-top:.4rem">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="rail-nav">
        <button class="rail-nav__btn" type="button" data-rail-prev aria-label="{{ 'pagination.previous' | t }}">
          <span class="rail-nav__arrow--back">{%- render 'icon', name: 'arrow' -%}</span>
        </button>
        <button class="rail-nav__btn" type="button" data-rail-next aria-label="{{ 'pagination.next' | t }}">
          {%- render 'icon', name: 'arrow' -%}
        </button>
      </div>
    </div>

    <div class="rail tm-rail" data-rail>
      {%- for block in section.blocks -%}
        {%- liquid
          # Sin foto se muestra la tarjeta azul con su reseña; con foto, el retrato.
          assign is_card = false
          if block.settings.image == blank or block.settings.featured
            assign is_card = true
          endif
          assign person_alt = block.settings.name | escape
        -%}

        <article class="tm {% if is_card %}tm--card{% endif %}" {{ block.shopify_attributes }}>
          {%- if is_card -%}
            <div class="tm__body">
              <h3 class="tm__name">{{ block.settings.name }}</h3>
              {%- if block.settings.role != blank -%}
                <p class="tm__role">{{ block.settings.role }}</p>
              {%- endif -%}
              {%- if block.settings.bio != blank -%}
                <p class="tm__bio">{{ block.settings.bio }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.tag != blank -%}
              <span class="tm__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
          {%- else -%}
            {{ block.settings.image | image_url: width: 600 | image_tag:
               widths: '250,400,600', sizes: '(min-width: 900px) 20vw, 60vw',
               loading: 'lazy', alt: person_alt }}
            <div class="tm__caption">
              <h3 class="tm__name">{{ block.settings.name }}</h3>
              {%- if block.settings.role != blank -%}
                <p class="tm__role">{{ block.settings.role }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .tm-rail { grid-auto-columns: minmax(230px, 1fr); }
  @media (min-width: 900px) {
    .tm-rail { grid-auto-columns: minmax(0, calc((100% - 4 * var(--gap)) / 5)); overflow-x: auto; }
    .tm-rail { scrollbar-width: none; }
    .tm-rail::-webkit-scrollbar { display: none; }
  }

  .tm {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    isolation: isolate;
  }

  .tm img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }

  /* Retrato: nombre y cargo sobre un degradado al pie */
  .tm__caption {
    position: relative;
    padding: 1rem .9rem;
    color: #fff;
    text-align: center;
  }
  .tm__caption::before {
    content: '';
    position: absolute; inset: -3rem 0 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(10,12,24,0) 0%, rgba(10,12,24,.82) 70%);
  }

  /* Tarjeta azul: reseña breve */
  .tm--card { background: var(--brand); color: var(--brand-ink); justify-content: flex-start; }
  .tm__body { padding: 1.3rem 1.2rem; }
  .tm__name { margin: 0; font-size: var(--step-0); font-weight: 700; line-height: 1.2; }
  .tm__role { margin: .25rem 0 0; font-size: var(--step--1); opacity: .85; }
  .tm--card .tm__role { opacity: .78; }
  .tm__bio {
    margin: .9rem 0 0;
    font-size: var(--step--1);
    line-height: 1.5;
    opacity: .82;
  }
  .tm__tag {
    position: absolute; left: 1.2rem; bottom: 1.2rem;
    padding: .3em .8em;
    border-radius: var(--radius-pill);
    background: rgba(255,255,255,.2);
    font-size: var(--step--1);
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Equipo (carrusel)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Nuestro equipo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quienes cuidan a tu mascota" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "default",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    },
    { "type": "checkbox", "id": "tight", "label": "Menos espacio arriba y abajo", "default": false }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Integrante",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Sin foto se muestra una tarjeta azul con su reseña." },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "role", "label": "Cargo" },
        { "type": "textarea", "id": "bio", "label": "Reseña breve", "info": "Se muestra sólo en la tarjeta azul." },
        { "type": "text", "id": "tag", "label": "Etiqueta (opcional)" },
        { "type": "checkbox", "id": "featured", "label": "Mostrar como tarjeta azul aunque tenga foto", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Equipo (carrusel)", "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }] }]
}
{% endschema %}
