<section class="section section--{{ section.settings.bg }}{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tm-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte muted">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tm-grid" style="--tm-cols: {{ section.settings.per_row }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign person_alt = block.settings.name | escape
        -%}
        <article class="tm" {{ block.shopify_attributes }} data-reveal>
          <div class="tm__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag:
                 widths: '200,320,500', sizes: '(min-width: 900px) 18vw, 45vw',
                 loading: 'lazy', alt: person_alt }}
            {%- else -%}
              {%- comment -%}Sin foto: ícono de profesional sobre el azul de marca{%- endcomment -%}
              <span class="tm__icon">{%- render 'icon', name: block.settings.icon -%}</span>
            {%- endif -%}
          </div>

          <h3 class="tm__name">{{ block.settings.name }}</h3>
          {%- if block.settings.role != blank -%}
            <p class="tm__role">{{ block.settings.role }}</p>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}
            <span class="tm__tag">{{ block.settings.tag }}</span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .tm-title { color: var(--brand); }
  .section--brand .tm-title { color: var(--brand-ink); }

  /* Grilla: el equipo se reparte en dos filas, no en un carrusel largo */
  .tm-grid {
    display: grid;
    gap: calc(var(--gap) * 1.1) var(--gap);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 620px) { .tm-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .tm-grid { grid-template-columns: repeat(var(--tm-cols, 5), 1fr); } }

  .tm { display: flex; flex-direction: column; min-width: 0; }

  .tm__media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-bottom: .85rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--brand);
  }

  .tm__media img { width: 100%; height: 100%; object-fit: cover; }

  .tm__icon { display: grid; color: var(--brand-ink); opacity: .9; }
  .tm__icon svg { width: 38%; height: auto; min-width: 42px; }

  /* El nombre y el cargo van debajo de la foto, en flujo normal:
     así no hay nada que se monte encima de nada. */
  .tm__name {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
    hyphens: auto;
  }

  .tm__role {
    margin: .2rem 0 0;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .section--brand .tm__role { color: rgba(255, 255, 255, .78); }

  .tm__tag {
    align-self: flex-start;
    margin-top: .55rem;
    padding: .25em .7em;
    border-radius: var(--radius-pill);
    background: var(--brand-soft);
    color: var(--brand);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .section--brand .tm__tag { background: rgba(255, 255, 255, .18); color: var(--brand-ink); }
{% endstylesheet %}

{% schema %}
{
  "name": "Equipo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Nuestro equipo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quienes cuidan a tu mascota" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "range", "id": "per_row", "label": "Por fila (escritorio)", "min": 3, "max": 6, "step": 1, "default": 5 },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "default",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    },
    { "type": "checkbox", "id": "tight", "label": "Menos espacio arriba y abajo", "default": false }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Integrante",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Sin foto se muestran sus iniciales." },
        {
          "type": "select", "id": "icon", "label": "Ícono (si no hay foto)", "default": "vet",
          "options": [
            { "value": "vet", "label": "Profesional" },
            { "value": "stethoscope", "label": "Estetoscopio" },
            { "value": "scissors", "label": "Peluquería" },
            { "value": "microscope", "label": "Laboratorio" },
            { "value": "heart", "label": "Corazón" },
            { "value": "paw", "label": "Huella" },
            { "value": "pharmacy", "label": "Farmacia" }
          ]
        },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "role", "label": "Cargo" },
        { "type": "textarea", "id": "bio", "label": "Reseña", "info": "No se muestra en la grilla; queda guardada para la página de equipo." },
        { "type": "text", "id": "tag", "label": "Etiqueta (opcional)" },
        { "type": "checkbox", "id": "featured", "label": "Destacar", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Equipo", "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }] }]
}
{% endschema %}
