<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap wrap--narrow">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Dudas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }
  ],
  "blocks": [
    { "type": "qa", "name": "Pregunta", "settings": [
      { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Atienden urgencias?" },
      { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Sí, dentro del horario de atención.</p>" } ] }
  ],
  "presets": [{ "name": "Preguntas frecuentes", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
