<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h1>{{ collection.title | default: 'collections.all' | t }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <p class="muted" style="margin-bottom:var(--gap)">
          {{ 'collections.products_count' | t: count: collection.products_count }}
        </p>

        <div class="grid grid--products">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product, reveal: true -%}
          {%- endfor -%}
        </div>

        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.empty' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'collections.all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Colección", "settings": [] }
{% endschema %}
