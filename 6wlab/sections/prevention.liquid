{%- comment -%}
  Salud preventiva. Replica en la web las campañas que ya publicamos en Instagram,
  con el mismo llamado: "Escríbenos para saber más".
{%- endcomment -%}
<section class="section prev prev--{{ section.settings.bg }}">
  <div class="wrap">
    <div class="prev__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="prev__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="prev__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="prev__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    <div class="prev__grid">
      {%- for block in section.blocks -%}
        <article class="prev__card" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.image != blank -%}
            {%- assign card_alt = block.settings.title | default: 'Salud preventiva' -%}
            <div class="prev__media">
              {{ block.settings.image | image_url: width: 760 | image_tag:
                 loading: 'lazy', sizes: '(min-width: 900px) 30vw, 90vw',
                 widths: '380, 560, 760', alt: card_alt, class: 'prev__img' }}
            </div>
          {%- endif -%}

          <div class="prev__body">
            <span class="prev__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
                {%- case block.settings.icon -%}
                  {%- when 'skin' -%}
                    <circle cx="21" cy="17" r="4.1"/><circle cx="43" cy="17" r="4.1"/><circle cx="12" cy="32" r="4.1"/><circle cx="52" cy="32" r="4.1"/><path d="M32 29c-6.6 0-11.6 5.6-11.6 11.9 0 5 3.5 8.6 8.3 8.6 1.6 0 2.3-.5 3.3-.5s1.7.5 3.3.5c4.8 0 8.3-3.6 8.3-8.6C43.6 34.6 38.6 29 32 29Z"/>
                  {%- when 'ear' -%}
                    <path d="M24 57c0-6-2-8.4-5-12.3C15.6 40.3 14 35.6 14 30.4 14 19.7 22.3 11 33 11s19 8.1 19 18.6c0 6.4-4.6 10.6-9.3 10.6-3.6 0-6.3-2.4-6.3-5.9"/><path d="M27 28.6c0-3.6 2.9-6.6 6.5-6.6s6.5 3 6.5 6.6c0 2.6-1.3 4.3-3.1 5.6"/>
                  {%- when 'worm' -%}
                    <path d="M8 46.5c0-4.6 3.6-7.6 7.9-7.6s7.6 2.9 7.6 7-3.1 6.8-6.7 6.8"/><path d="M26 39.6c0-4.6 3.6-7.7 8-7.7s8 3.1 8 7.2"/><path d="M44.4 31.6c0-4.6 3.6-7.7 8-7.7s8 3.1 8 7.3c0 3.5-2.2 6-5.3 6.8"/>
                  {%- when 'tick' -%}
                    <ellipse cx="32" cy="36" rx="11" ry="13.5"/><circle cx="32" cy="18.5" r="5.4"/><path d="M21 28 11.5 22M21 36H10M21 44l-9.5 6M43 28l9.5-6M43 36h11M43 44l9.5 6"/>
                  {%- when 'tooth' -%}
                    <path d="M22 8c4 0 5.6 1.9 10 1.9S38 8 42 8c6.2 0 9.6 4.8 9.6 11.8 0 6.4-2.1 9.6-3.5 15-1.1 4.3-1.3 8.3-2.4 13.1-.8 4-2.1 7.1-4.8 7.1-3.2 0-3.7-4.3-4.5-9.3C35.6 41.7 35.1 38 32 38s-3.6 3.7-4.4 7.7c-.8 5-1.3 9.3-4.5 9.3-2.7 0-4-3.1-4.8-7.1-1.1-4.8-1.3-8.8-2.4-13.1-1.4-5.4-3.5-8.6-3.5-15C12.4 12.8 15.8 8 22 8Z"/>
                  {%- when 'vaccine' -%}
                    <path d="m48 5 11 11M45.5 18.5 16 48l-10.5 2.5L8 40 37.5 10.5z"/><path d="m24 29 11 11"/>
                  {%- else -%}
                    <path d="M55 15a14.6 14.6 0 0 0-20.8 0L32 17.2l-2.2-2.2A14.6 14.6 0 0 0 9 35.6l2.7 2.7L32 58.6l20.3-20.3L55 35.6A14.6 14.6 0 0 0 55 15Z"/>
                {%- endcase -%}
              </svg>
            </span>

            {%- if block.settings.question != blank -%}
              <p class="prev__question">{{ block.settings.question }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="prev__name">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="prev__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="prev__cta">
        <a class="btn" href="{{ section.settings.cta_link | default: '#escribenos' }}">
          <svg class="prev__send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 11.5 21 4l-7.5 18-2.4-7.1L3 11.5Z"/>
          </svg>
          {{ section.settings.cta_label }}
        </a>
        {%- if section.settings.cta_note != blank -%}
          <p class="prev__note">{{ section.settings.cta_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .prev--surface { background: var(--surface); }
  .prev--white { background: #fff; }

  .prev__head { max-width: 46rem; margin-bottom: calc(var(--gap) * 1.4); }
  .prev__eyebrow {
    display: block; margin-bottom: .6rem;
    font-size: var(--step--1); font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--brand);
  }
  .prev__title { margin: 0; font-size: var(--step-3); letter-spacing: -.03em; line-height: 1.05; }
  .prev__intro { margin-top: .9rem; color: var(--ink-muted); }

  .prev__grid { display: grid; gap: var(--gap); grid-template-columns: 1fr; }

  @media (min-width: 640px) {
    .prev__grid { grid-template-columns: repeat(2, 1fr); }
  }
  /* En escritorio: dos tarjetas arriba y tres abajo */
  @media (min-width: 1000px) {
    .prev__grid { grid-template-columns: repeat(6, 1fr); }
    .prev__card:nth-child(1), .prev__card:nth-child(2) { grid-column: span 3; }
    .prev__card:nth-child(3), .prev__card:nth-child(4), .prev__card:nth-child(5) { grid-column: span 2; }
  }

  .prev__card {
    display: flex; flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #fff;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .prev--white .prev__card { background: var(--surface); border-color: transparent; }
  .prev__card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,0,0,.09); }

  .prev__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .prev__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s var(--ease); }
  .prev__card:hover .prev__img { transform: scale(1.04); }

  .prev__body { padding: calc(var(--gap) * 0.85); }

  .prev__icon {
    display: grid; place-items: center;
    width: 3rem; height: 3rem; margin-bottom: .9rem;
    border-radius: 50%;
    background: var(--brand); color: #fff;
  }
  .prev__icon svg { width: 1.75rem; height: 1.75rem; }

  .prev__question {
    margin: 0 0 .3rem;
    font-size: var(--step--1); font-weight: 700;
    color: var(--brand);
  }
  .prev__name { margin: 0; font-size: var(--step-1); letter-spacing: -.02em; line-height: 1.15; }
  .prev__text { margin: .5rem 0 0; font-size: var(--step--1); color: var(--ink-muted); }

  .prev__cta { margin-top: calc(var(--gap) * 1.3); text-align: center; }
  .prev__send { width: 1.1em; height: 1.1em; margin-right: .5em; vertical-align: -.18em; }
  .prev__note { margin: .8rem 0 0; font-size: var(--step--1); color: var(--ink-muted); }

  @media (prefers-reduced-motion: reduce) {
    .prev__card, .prev__img { transition: none; }
    .prev__card:hover { transform: none; }
    .prev__card:hover .prev__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Salud preventiva",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Salud preventiva" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Señales que conviene revisar a tiempo" },
    {
      "type": "richtext", "id": "intro", "label": "Texto introductorio",
      "default": "<p>Con la primavera aumentan las alergias, los parásitos y las molestias de piel y oídos. Una revisión a tiempo evita complicaciones.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Escríbenos para saber más" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" },
    { "type": "text", "id": "cta_note", "label": "Nota bajo el botón", "default": "También puedes llamarnos al +56 32 2833333 o escribirnos por WhatsApp." },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "surface",
      "options": [
        { "value": "surface", "label": "Gris suave" },
        { "value": "white", "label": "Blanco" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Campaña",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "skin",
          "options": [
            { "value": "skin", "label": "Piel y picazón" },
            { "value": "ear", "label": "Oídos" },
            { "value": "worm", "label": "Desparasitación" },
            { "value": "tick", "label": "Pulgas y garrapatas" },
            { "value": "tooth", "label": "Dental" },
            { "value": "vaccine", "label": "Vacunas" },
            { "value": "heart", "label": "Corazón" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Imagen de la campaña (opcional)" },
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Se rasca más de lo normal?" },
        { "type": "text", "id": "title", "label": "Título", "default": "Picazón frecuente" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Lamido excesivo, piel enrojecida o pérdida de pelo son señales que conviene revisar." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Salud preventiva",
      "blocks": [
        { "type": "item", "settings": { "icon": "skin", "question": "¿Se rasca más de lo normal?", "title": "Picazón frecuente", "text": "Lamido excesivo, piel enrojecida o pérdida de pelo son señales que conviene revisar." } },
        { "type": "item", "settings": { "icon": "ear", "question": "¿Sacude mucho la cabeza?", "title": "Cuidemos sus oídos", "text": "Una revisión a tiempo puede evitar molestias y complicaciones." } },
        { "type": "item", "settings": { "icon": "tick", "question": "Pulgas y garrapatas están de vuelta", "title": "Revisa regularmente su piel", "text": "Especialmente después de los paseos, en orejas, cuello, axilas y entre los dedos." } },
        { "type": "item", "settings": { "icon": "worm", "question": "También es tiempo de desparasitar", "title": "Protégelo todo el año", "text": "La desparasitación regular previene enfermedades y lo mantiene más sano y feliz." } },
        { "type": "item", "settings": { "icon": "tooth", "question": "Tu mascota también necesita cuidado dental", "title": "Destartraje dental", "text": "Evaluación, exámenes previos y procedimiento con hora agendada." } }
      ]
    }
  ]
}
{% endschema %}
