<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap">
    <div class="team {% if section.settings.image_right %}team--flip{% endif %}">
      <div class="team__media">
        {%- if section.settings.image != blank -%}
          {%- assign team_alt = section.settings.name | escape -%}
          {{ section.settings.image | image_url: width: 900 | image_tag:
             widths: '400,600,900', sizes: '(min-width: 900px) 48vw, 100vw',
             loading: 'lazy', alt: team_alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}

        {%- if section.settings.stat_figure != blank -%}
          <div class="team__badge">
            <strong>{{ section.settings.stat_figure }}</strong>
            {%- if section.settings.stat_text != blank -%}
              <span>{{ section.settings.stat_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="team__body stack">
        {%- if section.settings.role != blank -%}
          <div><span class="eyebrow">{{ section.settings.role }}</span></div>
        {%- endif -%}
        {%- if section.settings.name != blank -%}<h2>{{ section.settings.name }}</h2>{%- endif -%}
        {%- if section.settings.bio != blank -%}<div class="rte lede">{{ section.settings.bio }}</div>{%- endif -%}

        {%- if section.settings.credentials_title != blank or section.settings.credentials != blank -%}
          <div class="team__creds">
            {%- if section.settings.credentials_title != blank -%}
              <h3>{{ section.settings.credentials_title }}</h3>
            {%- endif -%}
            <div class="rte">{{ section.settings.credentials }}</div>
          </div>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="team__quote rte">{{ section.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <div><a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .team { display: grid; gap: calc(var(--gap) * 1.8); align-items: center; }
  .team__media { position: relative; }
  .team__media img, .team__media svg { width: 100%; border-radius: var(--radius); }
  .team__badge {
    position: absolute; left: 1rem; bottom: 1rem;
    padding: .85rem 1.15rem; border-radius: var(--radius);
    background: var(--brand); color: var(--brand-ink);
    box-shadow: var(--shadow);
  }
  .team__badge strong { display: block; font-size: var(--step-1); line-height: 1.1; }
  .team__badge span { font-size: var(--step--1); opacity: .85; }
  .team__creds { padding: 1.1rem 1.3rem; border-radius: var(--radius); background: var(--brand-soft); }
  .team__creds h3 { margin-bottom: .5rem; font-size: var(--step-0); }
  .team__creds ul { margin: 0; padding-left: 1.1rem; color: var(--ink-muted); }
  .team__quote {
    margin: 0; padding-left: 1.1rem;
    border-left: 3px solid var(--brand);
    color: var(--ink-muted); font-style: italic;
  }
  @media (min-width: 900px) {
    .team { grid-template-columns: 1fr 1.1fr; }
    .team--flip .team__media { order: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Equipo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "stat_figure", "label": "Cifra destacada", "default": "37+ años" },
    { "type": "text", "id": "stat_text", "label": "Texto de la cifra", "default": "siendo parte de Reñaca." },
    { "type": "text", "id": "role", "label": "Cargo" },
    { "type": "text", "id": "name", "label": "Nombre", "default": "Dr. Cristian Tapia Villarreal" },
    { "type": "richtext", "id": "bio", "label": "Reseña" },
    { "type": "text", "id": "credentials_title", "label": "Título de credenciales", "default": "Médico Veterinario" },
    { "type": "richtext", "id": "credentials", "label": "Credenciales" },
    { "type": "richtext", "id": "quote", "label": "Cita" },
    { "type": "text", "id": "link_label", "label": "Texto del botón" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "checkbox", "id": "image_right", "label": "Foto a la derecha", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }
  ],
  "presets": [{ "name": "Equipo" }]
}
{% endschema %}
