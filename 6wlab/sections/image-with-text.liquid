<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap">
    <div class="iwt {% if section.settings.flip %}iwt--flip{% endif %}">
      <div class="iwt__media">
        {%- if section.settings.image != blank -%}
          {%- assign img_alt = section.settings.heading | escape -%}
          {{ section.settings.image | image_url: width: 900 | image_tag:
             widths: '400,600,900', sizes: '(min-width: 900px) 50vw, 100vw',
             loading: 'lazy', alt: img_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="iwt__body stack">
        {%- if section.settings.eyebrow != blank -%}
          <div><span class="eyebrow">{{ section.settings.eyebrow }}</span></div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="iwt__points">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="iwt__tick">{%- render 'icon', name: 'paw' -%}</span>
                {{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <div><a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .iwt { display: grid; gap: calc(var(--gap) * 1.8); align-items: center; }
  .iwt__media img, .iwt__media svg { width: 100%; border-radius: var(--radius); }
  .iwt__points { margin: 0; padding: 0; list-style: none; display: grid; gap: .7rem; }
  .iwt__points li { display: flex; gap: .7rem; align-items: flex-start; }
  .iwt__tick { flex: 0 0 auto; width: 1.25rem; color: var(--brand); }
  @media (min-width: 900px) {
    .iwt { grid-template-columns: 1fr 1fr; }
    .iwt--flip .iwt__media { order: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Un equipo que conoce a tu mascota" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Atención cercana, sin apuros y con seguimiento.</p>" },
    { "type": "text", "id": "link_label", "label": "Texto del botón" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "checkbox", "id": "flip", "label": "Imagen a la derecha", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }
  ],
  "blocks": [
    { "type": "point", "name": "Punto", "settings": [
      { "type": "text", "id": "text", "label": "Texto", "default": "Equipamiento propio de diagnóstico" } ] }
  ],
  "presets": [{ "name": "Imagen con texto" }]
}
{% endschema %}
