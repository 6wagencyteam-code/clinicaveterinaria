<section class="section section--{{ section.settings.bg }}">
  <div class="wrap">
    <div class="rail-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rail-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <div class="rail-nav">
        <button class="rail-nav__btn" type="button" data-rail-prev
                aria-label="{{ 'pagination.previous' | t }}">
          <span class="rail-nav__arrow rail-nav__arrow--back">{%- render 'icon', name: 'arrow' -%}</span>
        </button>
        <button class="rail-nav__btn" type="button" data-rail-next
                aria-label="{{ 'pagination.next' | t }}">
          {%- render 'icon', name: 'arrow' -%}
        </button>
      </div>
    </div>

    {%- assign products = section.settings.collection.products -%}
    {%- if products.size > 0 -%}
      <div class="rail rail--products" data-rail style="--per-row: {{ section.settings.per_row }};">
        {%- for product in products limit: section.settings.limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.collection != blank -%}
      <p style="margin-top:var(--gap)">
        <a class="btn btn--ghost" href="{{ section.settings.collection.url }}">{{ section.settings.link_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rail-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1rem; margin-bottom: calc(var(--gap) * 1.4);
  }
  .rail-head__title { margin: 0; color: var(--brand); font-size: var(--step-3); }
  .section--brand .rail-head__title { color: var(--brand-ink); }

  .rail-nav { display: flex; gap: .5rem; flex: 0 0 auto; }
  .rail-nav__btn {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border: 1px solid var(--line); border-radius: var(--radius-pill);
    background: var(--bg); color: var(--brand);
    cursor: pointer;
    transition: border-color .15s var(--ease), background .15s var(--ease);
  }
  .rail-nav__btn:hover { border-color: var(--brand); background: var(--brand-soft); }
  .rail-nav__btn[disabled] { opacity: .35; cursor: default; }
  .rail-nav__btn svg { width: 1.15rem; height: 1.15rem; }
  .rail-nav__arrow--back { transform: rotate(180deg); display: grid; }

  /* Tarjetas sin marco: sólo foto, título y precio */
  .rail--products .product-card__media { background: transparent; }
  .rail--products .product-card__title {
    font-weight: 400; color: var(--ink-muted); font-size: var(--step-0);
  }
  .rail--products .price { font-size: var(--step-0); }

  @media (min-width: 900px) {
    .rail--products { grid-auto-columns: minmax(0, calc((100% - (var(--per-row) - 1) * var(--gap)) / var(--per-row))); overflow-x: auto; }
  }
  /* La barra de desplazamiento se oculta: se navega con las flechas */
  .rail--products { scrollbar-width: none; }
  .rail--products::-webkit-scrollbar { display: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Pet Picks Just For You" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 4, "max": 20, "step": 1, "default": 12 },
    { "type": "range", "id": "per_row", "label": "Productos visibles (escritorio)", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "link_label", "label": "Texto del botón" },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "default",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
