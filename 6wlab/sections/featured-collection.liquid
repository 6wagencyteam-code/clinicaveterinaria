<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap">
    <div class="section-head" style="display:flex;justify-content:space-between;align-items:end;gap:1rem;max-width:none">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 style="margin-bottom:0">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="btn btn--ghost btn--sm" href="{{ section.settings.collection.url }}">{{ 'products.view_details' | t }}</a>
      {%- endif -%}
    </div>

    {%- assign products = section.settings.collection.products -%}
    {%- if products.size > 0 -%}
      <div class="rail">
        {%- for product in products limit: section.settings.limit -%}
          {%- render 'product-card', product: product, reveal: true -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Tienda" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo más pedido" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
