<section class="ctab ctab--{{ section.settings.bg }}">
  <span class="ctab__ring ctab__ring--1" aria-hidden="true"></span>
  <span class="ctab__ring ctab__ring--2" aria-hidden="true"></span>

  <div class="wrap ctab__inner">
    <div class="ctab__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ctab__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ctab__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ctab__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ctab__actions">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <a class="ctab__btn ctab__btn--{{ block.settings.style }}"
               href="{{ block.settings.link }}"
               {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
               {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <span class="ctab__ico">{%- render 'icon', name: block.settings.icon -%}</span>
              {%- endif -%}
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ctab {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: calc(var(--pad-block) * 0.9);
    background: var(--brand);
    color: var(--brand-ink);
  }

  .ctab--dark { background: var(--ink); }

  /* Aros decorativos, como en tu bloque de contacto */
  .ctab__ring {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .14);
    pointer-events: none;
  }
  .ctab__ring--1 { width: min(420px, 70vw); aspect-ratio: 1; right: -90px; bottom: -160px; }
  .ctab__ring--2 { width: min(240px, 40vw); aspect-ratio: 1; right: 230px; top: -80px; border-color: rgba(255,255,255,.09); }

  .ctab__inner {
    display: grid;
    gap: calc(var(--gap) * 1.4);
    align-items: center;
  }

  @media (min-width: 860px) {
    .ctab__inner { grid-template-columns: 1.3fr auto; }
  }

  .ctab__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: .9rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .55);
  }
  .ctab__eyebrow::before {
    content: '';
    width: 22px; height: 1.5px;
    background: rgba(255, 255, 255, .45);
  }

  .ctab__title {
    margin: 0;
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.1rem);
    line-height: 1.02;
    letter-spacing: -.03em;
    text-wrap: balance;
  }

  .ctab__body { margin-top: .9rem; max-width: 46ch; opacity: .85; }

  .ctab__actions { display: flex; flex-direction: column; gap: .7rem; }

  @media (max-width: 859px) {
    .ctab__actions { flex-direction: row; flex-wrap: wrap; }
    .ctab__btn { flex: 1 1 200px; }
  }

  .ctab__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    padding: 1.05em 2em;
    border: 1.5px solid transparent;
    border-radius: 12px;
    font-size: var(--step-0);
    font-weight: 800;
    text-decoration: none;
    text-align: center;
    transition: transform .2s var(--ease), box-shadow .2s var(--ease), background .2s var(--ease);
  }

  .ctab__btn--solid { background: #fff; color: var(--brand); }
  .ctab__btn--ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,.4); }
  .ctab__btn--ghost:hover { border-color: #fff; background: rgba(255,255,255,.1); color: #fff; }
  .ctab__btn--solid:hover { color: var(--brand); }
  .ctab__btn:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(0,0,0,.22); }

  .ctab__ico { display: grid; width: 1.2rem; }
  .ctab__ico svg { width: 100%; height: auto; }

  @media (prefers-reduced-motion: reduce) {
    .ctab__btn { transition: none; }
    .ctab__btn:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banda de contacto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Peluquería canina" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Reserva la hora de peluquería" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "brand",
      "options": [
        { "value": "brand", "label": "Azul de marca" },
        { "value": "dark", "label": "Oscuro" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Botón",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Llámanos" },
        { "type": "url", "id": "link", "label": "Enlace" },
        {
          "type": "select", "id": "style", "label": "Estilo", "default": "solid",
          "options": [
            { "value": "solid", "label": "Relleno" },
            { "value": "ghost", "label": "Contorno" }
          ]
        },
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "phone",
          "options": [
            { "value": "none", "label": "Sin ícono" },
            { "value": "phone", "label": "Teléfono" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "mail", "label": "Correo" },
            { "value": "pin", "label": "Dirección" },
            { "value": "arrow", "label": "Flecha" }
          ]
        },
        { "type": "checkbox", "id": "new_tab", "label": "Abrir en pestaña nueva", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banda de contacto",
      "blocks": [
        { "type": "button", "settings": { "label": "Llámanos", "style": "solid", "icon": "phone" } },
        { "type": "button", "settings": { "label": "WhatsApp", "style": "ghost", "icon": "none" } }
      ]
    }
  ]
}
{% endschema %}
