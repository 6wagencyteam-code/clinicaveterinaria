<section class="promo" {% if section.settings.bg_color != blank %}style="background:{{ section.settings.bg_color }}"{% endif %}>
  <div class="promo__media">
    {%- if section.settings.image != blank -%}
      {%- assign promo_alt = section.settings.title | escape -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag:
         widths: '600,900,1400,1800', sizes: '100vw', loading: 'lazy', alt: promo_alt }}
    {%- endif -%}
  </div>

  <div class="promo__inner wrap">
    <div class="promo__body stack">
      {%- if section.settings.subtitle != blank -%}
        <div><span class="promo__tag">{{ section.settings.subtitle }}</span></div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="promo__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="promo__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <div><a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .promo { position: relative; isolation: isolate; overflow: hidden; }
  .promo__media { position: absolute; inset: 0; z-index: -1; }
  .promo__media img { width: 100%; height: 100%; object-fit: cover; }
  .promo__inner { display: flex; align-items: center; min-height: clamp(380px, 52vh, 620px); padding-block: var(--pad-block); }
  .promo__body { max-width: 34rem; }
  .promo__tag {
    display: inline-block; padding: .35em .9em; border-radius: var(--radius-pill);
    background: var(--brand); color: var(--brand-ink);
    font-size: var(--step--1); font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  }
  .promo__title { margin: 0; font-size: var(--step-4); }
  .promo__text { margin: 0; font-size: var(--step-1); color: var(--ink-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner promocional",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#F6F7FB" },
    { "type": "text", "id": "subtitle", "label": "Etiqueta", "default": "PET SHOP" },
    { "type": "text", "id": "title", "label": "Título", "default": "PURINA PRO PLAN" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Nueva fórmula para piel y estómago sensibles." },
    { "type": "text", "id": "link_label", "label": "Texto del botón", "default": "COMPRA AHORA" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "presets": [{ "name": "Banner promocional" }]
}
{% endschema %}
