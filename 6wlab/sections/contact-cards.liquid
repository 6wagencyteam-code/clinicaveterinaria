<section class="section section--{{ section.settings.bg }}{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head {% if section.settings.centered %}section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="lede rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign valor = block.settings.value
          assign destino = block.settings.link
          # Teléfono y WhatsApp arman su propio enlace a partir del número
          if block.settings.kind == 'phone' and valor != blank
            assign limpio = valor | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
            assign destino = 'tel:' | append: limpio
          elsif block.settings.kind == 'whatsapp' and valor != blank
            assign limpio = valor | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
            assign destino = 'https://wa.me/' | append: limpio
          elsif block.settings.kind == 'email' and valor != blank
            assign destino = 'mailto:' | append: valor
          endif
        -%}

        {%- if valor != blank -%}
          {%- assign etiqueta = 'div' -%}
          {%- if destino != blank -%}{%- assign etiqueta = 'a' -%}{%- endif -%}

          <{{ etiqueta }} class="cc cc--{{ block.settings.tone }}"
            {% if destino != blank %}href="{{ destino }}"{% endif %}
            {% if block.settings.new_tab and destino != blank %}target="_blank" rel="noopener"{% endif %}
            {{ block.shopify_attributes }} data-reveal>
            <span class="cc__ico">{%- render 'icon', name: block.settings.icon -%}</span>
            {%- if block.settings.label != blank -%}
              <span class="cc__label">{{ block.settings.label }}</span>
            {%- endif -%}
            <span class="cc__value">{{ valor }}</span>
            {%- if block.settings.note != blank -%}
              <span class="cc__note">{{ block.settings.note }}</span>
            {%- endif -%}
            {%- if destino != blank -%}
              <span class="cc__go" aria-hidden="true">{%- render 'icon', name: 'arrow' -%}</span>
            {%- endif -%}
          </{{ etiqueta }}>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cc-grid {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }
  /* Dos por fila en tablet y tres por fila en escritorio */
  @media (min-width: 640px) {
    .cc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .cc__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .cc {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) * 1.25);
    border-radius: var(--radius);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform .22s var(--ease), box-shadow .22s var(--ease);
  }

  a.cc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }

  /* Alternancia de tonos para que no se vea plano */
  .cc--brand { background: var(--brand); color: var(--brand-ink); }
  .cc--light { background: var(--bg); color: var(--ink); border: 1px solid var(--line); }
  .cc--dark  { background: var(--ink); color: #fff; }

  .cc__ico {
    display: grid;
    place-items: center;
    width: 3.1rem; height: 3.1rem;
    margin-bottom: 1.1rem;
    border-radius: var(--radius-pill);
  }
  .cc__ico svg { width: 1.5rem; height: 1.5rem; }
  .cc--brand .cc__ico, .cc--dark .cc__ico { background: rgba(255,255,255,.18); }
  .cc--light .cc__ico { background: var(--brand-soft); color: var(--brand); }

  .cc__label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .6;
  }

  .cc__value {
    margin-top: .3rem;
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }

  .cc__note { margin-top: .5rem; font-size: var(--step--1); opacity: .7; line-height: 1.5; }

  .cc__go {
    position: absolute;
    top: calc(var(--gap) * 1.25); right: calc(var(--gap) * 1.25);
    width: 1.2rem;
    opacity: .45;
    transition: transform .22s var(--ease), opacity .22s var(--ease);
  }
  a.cc:hover .cc__go { opacity: 1; transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .cc, .cc__go { transition: none; }
    a.cc:hover { transform: none; }
    a.cc:hover .cc__go { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tarjetas de contacto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Contacto" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hablemos" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "centered", "label": "Título centrado", "default": true },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "surface",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    },
    { "type": "checkbox", "id": "tight", "label": "Menos espacio arriba y abajo", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Dato de contacto",
      "settings": [
        {
          "type": "select", "id": "kind", "label": "Tipo", "default": "other",
          "info": "Teléfono, WhatsApp y correo arman el enlace solos.",
          "options": [
            { "value": "phone", "label": "Teléfono" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "email", "label": "Correo" },
            { "value": "other", "label": "Otro (uso el enlace de abajo)" }
          ]
        },
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "phone",
          "options": [
            { "value": "phone", "label": "Teléfono" },
            { "value": "mail", "label": "Correo" },
            { "value": "pin", "label": "Dirección" },
            { "value": "clock", "label": "Horario" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "ambulance", "label": "Urgencias" },
            { "value": "paw", "label": "Huella" }
          ]
        },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Teléfono" },
        { "type": "text", "id": "value", "label": "Valor" },
        { "type": "text", "id": "note", "label": "Nota (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace (sólo para tipo «Otro»)" },
        {
          "type": "select", "id": "tone", "label": "Color", "default": "light",
          "options": [
            { "value": "light", "label": "Blanco" },
            { "value": "brand", "label": "Azul" },
            { "value": "dark", "label": "Oscuro" }
          ]
        },
        { "type": "checkbox", "id": "new_tab", "label": "Abrir en pestaña nueva", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Tarjetas de contacto",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }
  ]
}
{% endschema %}
