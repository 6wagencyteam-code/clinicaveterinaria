{%- if section.settings.text != blank -%}
  <div class="announce">
    <div class="wrap">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de aviso",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "37 años cuidando a las mascotas de Reñaca" },
    { "type": "url", "id": "link", "label": "Enlace (opcional)" }
  ]
}
{% endschema %}
