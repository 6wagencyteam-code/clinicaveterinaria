<section class="section section--tight {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap">
    <div class="stats">
      {%- for block in section.blocks -%}
        <div class="stat" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="stat__icon">{%- render 'icon', name: block.settings.icon -%}</span>
          {%- endif -%}
          <p class="stat__figure" data-count="{{ block.settings.figure | escape }}">{{ block.settings.figure }}</p>
          <p class="stat__label">{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .stats {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    text-align: center;
  }
  .stat__icon {
    display: grid; place-items: center;
    width: 3rem; height: 3rem; margin: 0 auto .75rem;
    border-radius: var(--radius-pill);
    background: var(--brand-soft); color: var(--brand);
  }
  .stat__icon svg { width: 1.5rem; height: 1.5rem; }
  .stat__figure {
    margin: 0; font-family: var(--font-heading);
    font-size: var(--step-3); font-weight: 700; line-height: 1;
    letter-spacing: -0.03em; color: var(--brand);
  }
  .stat__label {
    margin: .4rem 0 0; font-size: var(--step--1); font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cifras",
  "settings": [
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Cifra",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "heart",
          "options": [
            { "value": "none", "label": "Sin ícono" },
            { "value": "heart", "label": "Corazón" },
            { "value": "paw", "label": "Huella" },
            { "value": "user", "label": "Persona" },
            { "value": "stethoscope", "label": "Estetoscopio" },
            { "value": "clock", "label": "Reloj" }
          ]
        },
        { "type": "text", "id": "figure", "label": "Cifra", "default": "37+" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "AÑOS DE EXPERIENCIA" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cifras",
      "blocks": [
        { "type": "stat", "settings": { "icon": "clock", "figure": "37+", "label": "AÑOS DE EXPERIENCIA" } },
        { "type": "stat", "settings": { "icon": "user", "figure": "5.000+", "label": "PACIENTES ATENDIDOS" } },
        { "type": "stat", "settings": { "icon": "heart", "figure": "+30", "label": "RAZAS ATENDIDAS" } }
      ]
    }
  ]
}
{% endschema %}
