<section class="section">
  <div class="wrap">
    <h1 class="section-head">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="grid">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}" data-reveal>
            {%- if article.image -%}
              {%- assign article_alt = article.title | escape -%}
              {{ article.image | image_url: width: 600 | image_tag:
                 widths: '300,600', sizes: '(min-width: 900px) 30vw, 90vw', loading: 'lazy',
                 alt: article_alt, class: 'card__media' }}
            {%- endif -%}
            <h2 class="card__title" style="margin-top:1rem">{{ article.title }}</h2>
            <p class="card__text">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            <span class="card__foot muted">{{ article.published_at | date: '%d/%m/%Y' }}</span>
          </a>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
