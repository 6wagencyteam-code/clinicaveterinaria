{%- liquid
  assign count = section.blocks.size
  if count > 3
    assign count = 3
  endif
-%}
<section class="hero-split hero-split--{{ count }}"
         style="--hero-h: {{ section.settings.height }}px;">
  {%- for block in section.blocks -%}
    {%- liquid
      assign tag = 'div'
      if block.settings.link != blank
        assign tag = 'a'
      endif
      if forloop.first
        assign loading_attr = 'eager'
      else
        assign loading_attr = 'lazy'
      endif
      assign panel_alt = block.settings.heading | escape
    -%}

    <{{ tag }} class="hero-panel"
      {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
      {{ block.shopify_attributes }}>

      {%- if block.settings.image != blank -%}
        {{ block.settings.image
           | image_url: width: 1400
           | image_tag:
             widths: '500,800,1100,1400',
             sizes: '(min-width: 800px) 60vw, 100vw',
             loading: loading_attr,
             alt: panel_alt }}
      {%- endif -%}

      <div class="hero-panel__body">
        <h2 class="hero-panel__title">{{ block.settings.heading }}</h2>

        <div class="hero-panel__reveal">
          {%- if block.settings.text != blank -%}
            <p class="hero-panel__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <span class="hero-panel__cta">
              {{ block.settings.link_label }}
              <span class="hero-panel__arrow">{%- render 'icon', name: 'arrow' -%}</span>
            </span>
          {%- endif -%}
        </div>
      </div>
    </{{ tag }}>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Portada dividida",
  "max_blocks": 3,
  "settings": [
    {
      "type": "range", "id": "height", "label": "Alto de las fotos",
      "min": 400, "max": 900, "step": 20, "unit": "px", "default": 680
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Clínica" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Consultas, cirugías, vacunas y más." },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver más" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portada dividida",
      "blocks": [
        { "type": "panel", "settings": { "heading": "Clínica" } },
        { "type": "panel", "settings": { "heading": "Tienda y Farmacia" } },
        { "type": "panel", "settings": { "heading": "Peluquería" } }
      ]
    }
  ]
}
{% endschema %}
