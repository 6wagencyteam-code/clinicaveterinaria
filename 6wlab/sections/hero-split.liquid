{%- liquid
  assign count = section.blocks.size
  if count > 3
    assign count = 3
  endif
-%}
<section class="hero-split hero-split--{{ count }}">
  {%- for block in section.blocks -%}
    {%- assign tag = 'div' -%}
    {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}

    {%- if forloop.first -%}
      {%- assign loading_attr = 'eager' -%}
    {%- else -%}
      {%- assign loading_attr = 'lazy' -%}
    {%- endif -%}

    <{{ tag }} class="hero-panel"
      {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
      {{ block.shopify_attributes }}>

      {%- if block.settings.image != blank -%}
        {{ block.settings.image
           | image_url: width: 1200
           | image_tag:
             widths: '400,600,900,1200',
             sizes: '(min-width: 800px) 34vw, 100vw',
             loading: loading_attr,
             alt: block.settings.heading | escape }}
      {%- endif -%}

      <h2>{{ block.settings.heading }}</h2>
      {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      {%- if block.settings.link != blank and block.settings.link_label != blank -%}
        <span class="hero-panel__cta">
          {{ block.settings.link_label }}
          <span style="width:1.1rem">{%- render 'icon', name: 'arrow' -%}</span>
        </span>
      {%- endif -%}
    </{{ tag }}>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Portada dividida",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Clínica" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Consultas, cirugías, vacunas y más." },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver más" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portada dividida",
      "blocks": [
        { "type": "panel", "settings": { "heading": "Clínica", "text": "Consultas, cirugías, vacunas y más. 37 años cuidando a tu mascota." } },
        { "type": "panel", "settings": { "heading": "Tienda y Farmacia", "text": "Alimentos premium, medicamentos y todo lo que tu mascota necesita." } },
        { "type": "panel", "settings": { "heading": "Peluquería", "text": "Baño sanitario, corte y estética con amor y paciencia." } }
      ]
    }
  ]
}
{% endschema %}
