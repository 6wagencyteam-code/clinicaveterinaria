<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lede rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid">
      {%- for block in section.blocks -%}
        <article class="card" data-reveal {{ block.shopify_attributes }}>
          <span class="card__icon">{%- render 'icon', name: block.settings.icon -%}</span>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          <div class="card__text rte">{{ block.settings.text }}</div>

          <div class="card__foot">
            {%- if block.settings.price != blank -%}
              <p class="card__price">
                {%- if block.settings.price_label != blank -%}
                  <small>{{ block.settings.price_label }}</small>
                {%- endif -%}
                {{ block.settings.price }}
              </p>
            {%- endif -%}

            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a class="btn btn--ghost btn--sm" href="{{ block.settings.link }}" style="margin-top:.75rem">
                {{ block.settings.link_label }}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicios",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Nuestros servicios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que tu mascota necesita" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>37 años cuidando a las mascotas de Reñaca con equipo propio y atención cercana.</p>" },
    { "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Servicio",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "stethoscope",
          "options": [
            { "value": "stethoscope", "label": "Estetoscopio" },
            { "value": "vaccine", "label": "Vacuna" },
            { "value": "scissors", "label": "Peluquería" },
            { "value": "surgery", "label": "Cirugía" },
            { "value": "lab", "label": "Laboratorio" },
            { "value": "pharmacy", "label": "Farmacia" },
            { "value": "paw", "label": "Huella" },
            { "value": "heart", "label": "Corazón" },
            { "value": "ambulance", "label": "Urgencias" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Consulta general" },
        { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Evaluación completa con diagnóstico y plan de tratamiento.</p>" },
        { "type": "text", "id": "price_label", "label": "Etiqueta del precio", "default": "Desde" },
        { "type": "text", "id": "price", "label": "Precio" },
        { "type": "text", "id": "link_label", "label": "Texto del botón", "default": "Reservar hora" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Servicios",
      "blocks": [
        { "type": "service", "settings": { "icon": "stethoscope", "title": "Consulta general" } },
        { "type": "service", "settings": { "icon": "vaccine", "title": "Vacunación" } },
        { "type": "service", "settings": { "icon": "scissors", "title": "Peluquería" } },
        { "type": "service", "settings": { "icon": "surgery", "title": "Cirugías" } }
      ]
    }
  ]
}
{% endschema %}
