<section class="section {% if section.settings.surface %}section--surface{% endif %}">
  <div class="wrap wrap--narrow text-center stack">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <div {{ block.shopify_attributes }}><span class="eyebrow">{{ block.settings.text }}</span></div>
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="lede rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div {{ block.shopify_attributes }}>
            <a class="btn" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto destacado",
  "settings": [{ "type": "checkbox", "id": "surface", "label": "Fondo gris suave", "default": false }],
  "blocks": [
    { "type": "eyebrow", "name": "Texto pequeño", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Sobre nosotros" }] },
    { "type": "heading", "name": "Título", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Cuidamos a tu mascota como si fuera nuestra" }] },
    { "type": "text", "name": "Párrafo", "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Somos una clínica de barrio con equipamiento de primer nivel.</p>" }] },
    { "type": "button", "name": "Botón", "settings": [
      { "type": "text", "id": "label", "label": "Texto", "default": "Conócenos" },
      { "type": "url", "id": "link", "label": "Enlace" } ] }
  ],
  "presets": [{ "name": "Texto destacado", "blocks": [{ "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
