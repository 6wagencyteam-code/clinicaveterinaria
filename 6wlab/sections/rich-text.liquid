{%- assign rt_split = false -%}
{%- if section.settings.image != blank -%}{%- assign rt_split = true -%}{%- endif -%}
<section class="section section--{{ section.settings.bg }}{% if section.settings.join_next %} section--joined-bottom{% endif %}">
  <div class="wrap{% unless rt_split %} wrap--narrow{% endunless %}{% if rt_split %} rtx{% endif %}">
    <div class="{% if rt_split %}rtx__body stack{% else %}text-center stack{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <div {{ block.shopify_attributes }}><span class="eyebrow">{{ block.settings.text }}</span></div>
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="lede rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div {{ block.shopify_attributes }}>
            <a class="btn" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
    </div>

    {%- if rt_split -%}
      {%- assign rt_alt = section.settings.image_alt | default: shop.name -%}
      <div class="rtx__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag:
           widths: '500,760,1000,1200', sizes: '(min-width: 900px) 46vw, 92vw',
           loading: 'lazy', alt: rt_alt, class: 'rtx__img' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rtx { display: grid; gap: calc(var(--gap) * 1.6); align-items: center; }
  @media (min-width: 900px) {
    .rtx { grid-template-columns: 1fr 1fr; }
    .rtx__body { text-align: left; }
  }
  .rtx__media { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; }
  .rtx__img { width: 100%; height: 100%; object-fit: cover; display: block; }
{% endstylesheet %}

{% schema %}
{
  "name": "Texto destacado",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen al costado (opcional)" },
    { "type": "text", "id": "image_alt", "label": "Descripción de la imagen" },
    {
      "type": "select", "id": "bg", "label": "Fondo", "default": "default",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris suave" },
        { "value": "brand", "label": "Azul de marca" }
      ]
    },
    { "type": "checkbox", "id": "join_next", "label": "Unir con la sección siguiente", "default": false }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Texto pequeño", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Sobre nosotros" }] },
    { "type": "heading", "name": "Título", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Cuidamos a tu mascota como si fuera nuestra" }] },
    { "type": "text", "name": "Párrafo", "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Somos una clínica de barrio con equipamiento de primer nivel.</p>" }] },
    { "type": "button", "name": "Botón", "settings": [
      { "type": "text", "id": "label", "label": "Texto", "default": "Conócenos" },
      { "type": "url", "id": "link", "label": "Enlace" } ] }
  ],
  "presets": [{ "name": "Texto destacado", "blocks": [{ "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
