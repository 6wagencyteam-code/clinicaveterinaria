<section class="section">
  <div class="wrap">
    <div class="section-head" style="display:flex;justify-content:space-between;align-items:end;gap:1rem;max-width:none">
      <h1 style="margin:0">{{ 'customer.account_title' | t }}</h1>
      <a class="btn btn--ghost btn--sm" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
    </div>

    <div style="display:grid;gap:calc(var(--gap)*1.5);grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr))">
      <div>
        <h2 style="font-size:var(--step-1)">{{ 'customer.orders' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <div class="table-scroll">
            <table class="rte" style="width:100%">
              <thead>
                <tr>
                  <th>{{ 'customer.order_number' | t }}</th>
                  <th>{{ 'customer.date' | t }}</th>
                  <th>{{ 'customer.status' | t }}</th>
                  <th>{{ 'customer.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="muted">{{ 'customer.no_orders' | t }}</p>
        {%- endif -%}
      </div>

      <div>
        <h2 style="font-size:var(--step-1)">{{ 'customer.addresses' | t }}</h2>
        {%- if customer.default_address -%}
          <p class="muted">{{ customer.default_address | format_address }}</p>
        {%- endif -%}
        <a class="btn btn--ghost btn--sm" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a>
      </div>
    </div>
  </div>
</section>
