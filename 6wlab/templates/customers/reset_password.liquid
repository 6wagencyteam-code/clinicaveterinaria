<section class="section">
  <div class="wrap" style="max-width:440px">
    <h1 class="section-head">{{ 'customer.reset' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="notice notice--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label for="rs-pass">{{ 'customer.new_password' | t }}</label>
        <input id="rs-pass" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="rs-conf">{{ 'customer.confirm_password' | t }}</label>
        <input id="rs-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn btn--full" type="submit">{{ 'customer.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
