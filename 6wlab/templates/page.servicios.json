    "servicios_custom": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .renaca-servicios {\n    padding: 40px 5%;\n    background: #ffffff;\n    font-family: 'Outfit', sans-serif;\n  }\n\n  .renaca-servicios__header {\n    max-width: 680px;\n    margin-bottom: 24px;\n  }\n\n  .renaca-servicios__eyebrow {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #2B41F5;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 14px;\n  }\n\n  .renaca-servicios__eyebrow::before {\n    content: '';\n    width: 20px;\n    height: 1.5px;\n    background: #2B41F5;\n    display: block;\n  }\n\n  .renaca-servicios__title {\n    font-size: clamp(28px, 4vw, 48px);\n    font-weight: 900;\n    color: #111111;\n    line-height: 1.05;\n    letter-spacing: -0.025em;\n    margin-bottom: 16px;\n  }\n\n  .renaca-servicios__title em {\n    color: #2B41F5;\n    font-style: normal;\n  }\n\n  .renaca-servicios__subtitle {\n    font-size: 15px;\n    color: #777777;\n    line-height: 1.6;\n    margin-bottom: 20px;\n  }\n\n  .renaca-servicios__cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #2B41F5;\n    color: #ffffff;\n    text-decoration: none;\n    padding: 14px 28px;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    transition: background 0.2s;\n    margin-bottom: 24px;\n  }\n\n  .renaca-servicios__cta:hover {\n    background: #1A2DB8;\n    color: #ffffff;\n  }\n\n  .renaca-servicios__grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n  }\n\n  .renaca-scard {\n    border-radius: 14px;\n    padding: 1.5rem;\n    border: 0.5px solid #E8E8E8;\n    background: #ffffff;\n    transition: border-color 0.2s, transform 0.2s;\n  }\n\n  .renaca-scard:hover {\n    border-color: #2B41F5;\n    transform: translateY(-3px);\n  }\n\n  .renaca-scard--featured {\n    background: #2B41F5;\n    border-color: #2B41F5;\n  }\n\n  .renaca-scard--featured:hover {\n    border-color: #1A2DB8;\n    background: #1A2DB8;\n  }\n\n  .renaca-scard__icon {\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 16px;\n    background: #F0F0F0;\n    flex-shrink: 0;\n  }\n\n  .renaca-scard--featured .renaca-scard__icon {\n    background: rgba(255,255,255,0.15);\n  }\n\n  .renaca-scard__icon svg { width: 24px; height: 24px; }\n\n  .renaca-scard__title {\n    font-size: 16px;\n    font-weight: 800;\n    color: #111111;\n    margin-bottom: 8px;\n    letter-spacing: -0.01em;\n    line-height: 1.2;\n  }\n\n  .renaca-scard--featured .renaca-scard__title { color: #ffffff; }\n\n  .renaca-scard__desc {\n    font-size: 13px;\n    color: #777777;\n    line-height: 1.6;\n    margin-bottom: 14px;\n  }\n\n  .renaca-scard--featured .renaca-scard__desc { color: rgba(255,255,255,0.65); }\n\n  .renaca-scard__tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 5px;\n  }\n\n  .renaca-scard__tag {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    padding: 3px 9px;\n    border-radius: 20px;\n    background: #F0F0F0;\n    color: #555555;\n    white-space: nowrap;\n  }\n\n  .renaca-scard--featured .renaca-scard__tag {\n    background: rgba(255,255,255,0.15);\n    color: rgba(255,255,255,0.85);\n  }\n\n  @media (max-width: 960px) {\n    .renaca-servicios__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }\n  }\n\n  @media (max-width: 640px) {\n    .renaca-servicios { padding: 36px 4%; }\n    .renaca-servicios__header { margin-bottom: 20px; }\n    .renaca-servicios__grid { grid-template-columns: 1fr; gap: 12px; }\n    .renaca-servicios__title { font-size: 26px; letter-spacing: -0.02em; }\n    .renaca-servicios__subtitle { font-size: 14px; }\n    .renaca-scard { padding: 1.25rem; border-radius: 12px; }\n    .renaca-scard:hover { transform: none; }\n    .renaca-scard__title { font-size: 15px; }\n    .renaca-scard__icon { width: 42px; height: 42px; margin-bottom: 12px; }\n    .renaca-servicios__cta { width: 100%; justify-content: center; }\n  }\n\n  @media (max-width: 380px) {\n    .renaca-servicios { padding: 28px 4%; }\n    .renaca-servicios__title { font-size: 23px; }\n    .renaca-scard__tag { font-size: 9px; padding: 3px 7px; }\n  }\n</style>\n\n<section class=\"renaca-servicios\">\n\n  <div class=\"renaca-servicios__header\">\n    <div class=\"renaca-servicios__eyebrow\">Nuestros servicios</div>\n    <h2 class=\"renaca-servicios__title\">\n      Todo lo que tu mascota necesita,<br>\n      <em>en un solo lugar.</em>\n    </h2>\n    <p class=\"renaca-servicios__subtitle\">\n      Atención integral para caninos, felinos y pacientes exóticos. Desde vacunas hasta cirugía ortopédica. Todo bajo el mismo techo.\n    </p>\n    <a href=\"tel:+56322833333\" class=\"renaca-servicios__cta\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M5 6h2l2 5-1.5 1a11 11 0 005.5 5.5l1-1.5 5 2v2a2 2 0 01-2 2C8 22 4 14 4 8a2 2 0 012-2z\"/>\n      </svg>\n      Pedir hora +56 32 2833333\n    </a>\n  </div>\n\n  <div class=\"renaca-servicios__grid\">\n\n    <div class=\"renaca-scard renaca-scard--featured\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 5v14M5 12h14\"/><circle cx=\"13\" cy=\"13\" r=\"9\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Cirugía veterinaria</div>\n      <div class=\"renaca-scard__desc\">Quirófano completo con monitor multiparamétrico, anestesia inhalatoria y mesa quirúrgica profesional. El nivel clínico que tu mascota merece.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">General</span>\n        <span class=\"renaca-scard__tag\">Ortopédica</span>\n        <span class=\"renaca-scard__tag\">Tejidos blandos</span>\n      </div>\n    </div>\n\n    <div class=\"renaca-scard\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#2B41F5\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Consulta médica</div>\n      <div class=\"renaca-scard__desc\">Diagnóstico integral y tratamiento personalizado. Atención a domicilio disponible en Reñaca, Concón y alrededores.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">Medicina general</span>\n        <span class=\"renaca-scard__tag\">Domicilios</span>\n      </div>\n    </div>\n\n    <div class=\"renaca-scard\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#2B41F5\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Vacunación y prevención</div>\n      <div class=\"renaca-scard__desc\">Plan vacunal completo para perros y gatos. Desparasitaciones internas y externas, y aplicación de microchip de identificación.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">Vacunas</span>\n        <span class=\"renaca-scard__tag\">Desparasitación</span>\n        <span class=\"renaca-scard__tag\">Microchip</span>\n      </div>\n    </div>\n\n    <div class=\"renaca-scard\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#2B41F5\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Exámenes y diagnóstico</div>\n      <div class=\"renaca-scard__desc\">Ecografías, radiografías y toma de muestras para laboratorio. Diagnósticos precisos con equipamiento de último nivel.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">Ecografía</span>\n        <span class=\"renaca-scard__tag\">Radiografía</span>\n        <span class=\"renaca-scard__tag\">Laboratorio</span>\n      </div>\n    </div>\n\n    <div class=\"renaca-scard\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#2B41F5\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"8\" cy=\"7\" r=\"2.5\"/>\n          <circle cx=\"8\" cy=\"17\" r=\"2.5\"/>\n          <path d=\"M10.5 8.5L20 16M10.5 15.5L20 8\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Peluquería canina</div>\n      <div class=\"renaca-scard__desc\">Baño sanitario y estética canina profesional. Tu mascota sale limpia, bien cuidada y feliz con el mejor trato.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">Baño sanitario</span>\n        <span class=\"renaca-scard__tag\">Corte</span>\n        <span class=\"renaca-scard__tag\">Estética</span>\n      </div>\n    </div>\n\n    <div class=\"renaca-scard\">\n      <div class=\"renaca-scard__icon\">\n        <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#2B41F5\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z\"/>\n          <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/>\n          <path d=\"M16 10a4 4 0 01-8 0\"/>\n        </svg>\n      </div>\n      <div class=\"renaca-scard__title\">Farmacia y Pet Shop</div>\n      <div class=\"renaca-scard__desc\">Farmacia veterinaria completa y tienda con alimentos premium Brit y Pro Plan, accesorios y todo lo que tu mascota necesita.</div>\n      <div class=\"renaca-scard__tags\">\n        <span class=\"renaca-scard__tag\">Medicamentos</span>\n        <span class=\"renaca-scard__tag\">Brit · Pro Plan</span>\n        <span class=\"renaca-scard__tag\">Accesorios</span>\n      </div>\n    </div>\n\n  </div>\n</section>"
      }
    }
