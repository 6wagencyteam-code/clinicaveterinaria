<section class="section">
  <div class="wrap wrap--narrow text-center stack">
    <h1>{{ shop.name }}</h1>
    <div class="rte lede">{{ shop.password_message }}</div>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="notice notice--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap;max-width:420px;margin-inline:auto">
        <input class="input" style="flex:1 1 200px" type="password" name="password"
               aria-label="{{ 'customer.password' | t }}" required>
        <button class="btn" type="submit">{{ 'customer.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
