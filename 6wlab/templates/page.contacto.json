    ¿Tu mascota necesita<br>\n          atención <em>hoy</em>?\n        </h2>\n      </div>\n      <div class=\"renaca-contacto__cta-btns\">\n        <a href=\"tel:+56322833333\" class=\"renaca-contacto__btn-white\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M5 6h2l2 5-1.5 1a11 11 0 005.5 5.5l1-1.5 5 2v2a2 2 0 01-2 2C8 22 4 14 4 8a2 2 0 012-2z\"/>\n          </svg>\n          +56 32 2833333\n        </a>\n        <a href=\"https://wa.me/56998206789\" class=\"renaca-contacto__btn-ghost\" target=\"_blank\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\"/>\n          </svg>\n          +56 9 9820 6789\n        </a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"renaca-contacto__bottom\">\n\n    <div class=\"renaca-contacto__info\">\n      <div>\n        <div class=\"renaca-contacto__info-title\">Horarios de atención</div>\n        <div class=\"renaca-contacto__horarios\">\n          <div class=\"renaca-contacto__horario-row\">\n            <span class=\"renaca-contacto__horario-day\">Lunes a Viernes</span>\n            <span class=\"renaca-contacto__horario-time\">9:30 a 20:00</span>\n          </div>\n          <div class=\"renaca-contacto__horario-row\">\n            <span class=\"renaca-contacto__horario-day\">Sábado</span>\n            <span class=\"renaca-contacto__horario-time\">10:30 a 17:30</span>\n          </div>\n          <div class=\"renaca-contacto__horario-row\">\n            <span class=\"renaca-contacto__horario-day\">Domingo</span>\n            <span class=\"renaca-contacto__horario-time closed\">Cerrado</span>\n          </div>\n        </div>\n      </div>\n      <div>\n        <div class=\"renaca-contacto__info-title\">Síguenos</div>\n        <a href=\"https://instagram.com/veterinaria_renaca\" class=\"renaca-contacto__ig\" target=\"_blank\">\n          <div class=\"renaca-contacto__ig-icon\">\n            <svg viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"3\" y=\"3\" width=\"20\" height=\"20\" rx=\"5\"/>\n              <circle cx=\"13\" cy=\"13\" r=\"4\"/>\n              <circle cx=\"18.5\" cy=\"7.5\" r=\"1\" fill=\"#fff\" stroke=\"none\"/>\n            </svg>\n          </div>\n          <div>\n            <div class=\"renaca-contacto__ig-label\">Instagram</div>\n            <div class=\"renaca-contacto__ig-value\">@veterinaria_renaca</div>\n          </div>\n        </a>\n      </div>\n    </div>\n\n    <!-- MAPA REAL, coordenadas exactas Angamos 376 Reñaca -->\n    <div class=\"renaca-contacto__map\">\n      <iframe\n        src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1474.2!2d-71.541742!3d-32.9717369!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9689dd0fa8f31c15%3A0x782d172705b41827!2sClinica%20Veterinaria%20Re%C3%B1aca!5e0!3m2!1ses!2scl!4v1720000000000!5m2!1ses!2scl\"\n        allowfullscreen=\"\"\n        loading=\"lazy\"\n        referrerpolicy=\"no-referrer-when-downgrade\"\n        title=\"Clínica Veterinaria Reñaca, Angamos 376\">\n      </iframe>\n      <div class=\"renaca-contacto__map-overlay\">\n        <div class=\"renaca-contacto__map-name\">Clínica Veterinaria Reñaca</div>\n        <div class=\"renaca-contacto__map-sub\">Angamos 376, Reñaca · Viña del Mar</div>\n      </div>\n      <a href=\"https://www.google.com/maps/place/Clinica+Veterinaria+Re%C3%B1aca/@-32.9717369,-71.541742\" target=\"_blank\" class=\"renaca-contacto__map-btn\">\n        <svg width=\"11\" height=\"11\" viewBox=\"0 0 26 26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"roun