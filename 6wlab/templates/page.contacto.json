      "settings": {
        "custom_liquid": "<style>\n  .renaca-contacto {\n    font-family: 'Outfit', sans-serif;\n  }\n\n  .renaca-contacto__cta {\n    background: #2B41F5;\n    padding-block: 80px;\n    padding-inline: max(1.25rem, (100vw - var(--wrap, 1280px)) / 2);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .renaca-contacto__geo1 {\n    position: absolute;\n    width: 400px; height: 400px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.06);\n    right: -80px; bottom: -120px;\n    pointer-events: none;\n  }\n\n  .renaca-contacto__geo2 {\n    position: absolute;\n    width: 240px; height: 240px;\n    border-radius: 50%;\n    border: 1px solid rgba(255,255,255,0.04);\n    right: 200px; top: -60px;\n    pointer-events: none;\n  }\n\n  .renaca-contacto__cta-inner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 40px;\n    position: relative;\n    z-index: 2;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .renaca-contacto__eyebrow {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.4);\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 16px;\n  }\n\n  .renaca-contacto__eyebrow::before {\n    content: '';\n    width: 16px; height: 1.5px;\n    background: rgba(255,255,255,0.25);\n    display: block;\n  }\n\n  .renaca-contacto__cta-title {\n    font-size: clamp(28px, 3.5vw, 44px);\n    font-weight: 900;\n    color: #ffffff;\n    line-height: 1.05;\n    letter-spacing: -0.025em;\n    margin-bottom: 0;\n  }\n\n  .renaca-contacto__cta-title em {\n    color: rgba(255,255,255,0.35);\n    font-style: normal;\n  }\n\n  .renaca-contacto__cta-btns {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    flex-shrink: 0;\n  }\n\n  .renaca-contacto__btn-white {\n    background: #ffffff;\n    color: #2B41F5;\n    border: none;\n    padding: 16px 32px;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-size: 15px;\n    font-weight: 800;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    white-space: nowrap;\n    transition: opacity 0.2s;\n  }\n\n  .renaca-contacto__btn-white:hover { opacity: 0.9; color: #2B41F5; }\n\n  .renaca-contacto__btn-ghost {\n    background: transparent;\n    color: rgba(255,255,255,0.8);\n    border: 1.5px solid rgba(255,255,255,0.25);\n    padding: 15px 32px;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    white-space: nowrap;\n  }\n\n  .renaca-contacto__btn-ghost:hover {\n    border-color: rgba(255,255,255,0.5);\n    color: #ffffff;\n  }\n\n  .renaca-contacto__bottom {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    background: #2B41F5;\n    border-top: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .renaca-contacto__info {\n    background: #2B41F5;\n    padding-block: 56px;\n    padding-left: max(1.25rem, (100vw - var(--wrap, 1280px)) / 2);\n    padding-right: 2.5rem;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 36px;\n  }\n\n  .renaca-contacto__info-title {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.35);\n    margin-bottom: 14px;\n  }\n\n  .renaca-contacto__horarios {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .renaca-contacto__horario-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 11px 0;\n    border-bottom: 0.5px solid rgba(255,255,255,0.08);\n  }\n\n  .renaca-contacto__horario-row:last-child { border-bottom: none; }\n\n  .renaca-contacto__horario-day {\n    font-size: 13px;\n    color: rgba(255,255,255,0.5);\n    font-weight: 500;\n  }\n\n  .renaca-contacto__horario-time {\n    font-size: 14px;\n    font-weight: 800;\n    color: #ffffff;\n  }\n\n  .renaca-contacto__horario-time.closed {\n    color: rgba(255,255,255,0.25);\n    font-weight: 500;\n    font-size: 12px;\n  }\n\n  .renaca-contacto__ig {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    text-decoration: none;\n    transition: opacity 0.2s;\n  }\n\n  .renaca-contacto__ig:hover { opacity: 0.7; }\n\n  .renaca-contacto__ig-icon {\n    width: 40px; height: 40px;\n    background: rgba(255,255,255,0.1);\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .renaca-contacto__ig-icon svg { width: 18px; height: 18px; }\n\n  .renaca-contacto__ig-label {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.3);\n    margin-bottom: 2px;\n  }\n\n  .renaca-contacto__ig-value {\n    font-size: 15px;\n    font-weight: 800;\n    color: #ffffff;\n  }\n\n  /* MAP */\n  @media (max-width: 899px) {\n    .renaca-contacto__info { padding-inline: 1.25rem; }\n  }\n\n  .renaca-contacto__map {\n    position: relative;\n    min-height: 420px;\n    overflow: hidden;\n    border-left: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .renaca-contacto__map iframe {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%;\n    height: 100%;\n    border: none;\n    display: block;\n    filter: saturate(0.2) brightness(0.55) hue-rotate(210deg);\n  }\n\n  .renaca-contacto__map-overlay {\n    position: absolute;\n    bottom: 0; left: 0; right: 0;\n    background: linear-gradient(to top, rgba(27,44,200,0.95) 0%, rgba(27,44,200,0.4) 50%, transparent 100%);\n    padding: 20px 24px;\n    pointer-events: none;\n  }\n\n  .renaca-contacto__map-name {\n    font-size: 13px;\n    font-weight: 800;\n    color: #fff;\n    margin-bottom: